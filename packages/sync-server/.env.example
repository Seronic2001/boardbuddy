PORT=8787
# Ed25519 public key (SPKI PEM, newlines as \n). Generate with: npm run keys -w @boardbuddy/sync-server
SYNC_PUBLIC_KEY=
# Omit to use in-memory storage (data is lost on restart).
DATABASE_URL=postgres://buddysync:buddysync@localhost:5433/buddysync
# Comma-separated browser origins allowed to connect. Omit to allow any (dev only).
ALLOWED_ORIGINS=http://localhost:3000
