{
  "name": "@boardbuddy/sync-server",
  "version": "0.1.0",
  "private": true,
  "description": "BuddySync WebSocket server: rooms, token auth, group-commit persistence, presence relay.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "tsx src/main.ts",
    "keys": "tsx scripts/generate-keys.ts",
    "migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "node build.mjs",
    "start:dist": "node --enable-source-maps dist/main.mjs"
  },
  "dependencies": {
    "@boardbuddy/sync-core": "*",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8.15.0",
    "@types/ws": "^8.18.0",
    "esbuild": "^0.27.0",
    "fast-check": "^4.10.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
